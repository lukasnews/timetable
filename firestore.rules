rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Zugriff nur mit der geheimen Familien-ID (aus dem Einladungslink/QR-Code).
    // Die Liste aller Familien kann niemand abfragen; Abfragen über alle Familien hinweg
    // (Collection-Group) sind ohne rekursive Regel ebenfalls verboten.
    match /families/{familyId}/{col}/{docId} {
      // Nur Familie und Sammlung prüfen – beim Lesen ganzer Listen gibt es keine einzelne Dokument-ID
      function familyPath() {
        return request.auth != null
          && familyId.matches('^[a-z0-9]{16,40}$')
          && col in ['persons', 'events', 'timetables', 'meta', 'backups'];
      }
      allow get, list, delete: if familyPath();
      // Schreiben: Dokumente in vernünftiger Größe (Schutz vor Missbrauch des Speichers)
      allow create, update: if familyPath() && docId.size() <= 200 && request.resource.data.size() <= 200;
    }
  }
}
