rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Zugriff nur mit der geheimen Familien-ID (aus dem Einladungslink/QR-Code).
    // Die Liste aller Familien kann niemand abfragen.
    match /families/{familyId}/{col}/{docId} {
      allow read, write: if request.auth != null
        && familyId.size() >= 16
        && col in ['persons', 'events', 'timetables', 'meta'];
    }
  }
}
